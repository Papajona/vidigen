{
  "name": "vidigen-ai",
  "main": "worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "api.vidigen.online",
      "custom_domain": true
    },
    {
      "pattern": "vidigen.online",
      "custom_domain": true
    },
    {
      "pattern": "www.vidigen.online",
      "custom_domain": true
    }
  ]
}
