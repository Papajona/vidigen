VIDIGEN_GATEWAY_TOKEN=change-me
VIDIGEN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VIDIGEN_RATE_LIMIT=30
VIDIGEN_MAX_AUDIO_BYTES=50000000
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5

# Supabase production persistence/auth. Keep the service-role key server-side only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_AUD=authenticated

# Provider secrets are server-side only.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=
SEEDANCE_API_URL=
SEEDANCE_API_TOKEN=
RUNWAY_API_URL=
RUNWAY_API_TOKEN=

# Optional Cloudflare R2/S3-compatible storage (large media should not live in Postgres).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public/CDN base URL your bucket is served from (custom domain or *.r2.dev) — used to build
# the final playable URL after a client uploads via /api/r2-presign.
R2_PUBLIC_BASE_URL=

# Billing / subscriptions
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
VIDIGEN_BILLING_ENFORCE=true
VIDIGEN_BILLING_CURRENCY=GHS
VIDIGEN_BILLING_CALLBACK_URL=
# Google Pay is only enabled when the configured processor/merchant account has been verified.
GOOGLE_PAY_ENABLED=false
# Leave blank until Google approves a production integration and a supported processor is confirmed.
GOOGLE_PAY_PROCESSOR=

# Brain output learning
VIDIGEN_AUTO_LEARN_OUTPUTS=true
VIDIGEN_LEARNING_ALLOWED_HOSTS=

# Optional: Groq (fast/cheap LLM inference) for the AI Editor's natural-language command
# parsing. Without this, /api/edit-plan falls back to a much more limited keyword matcher —
# the app still works, just understands far fewer phrasings.
GROQ_API_KEY=
GROQ_EDIT_MODEL=llama-3.3-70b-versatile

VIDIGEN_ADMIN_2FA_REQUIRED=true
VIDIGEN_MAX_RENDER_CLIPS=50
VIDIGEN_MAX_RENDER_BYTES=500000000
VIDIGEN_RENDER_TIMEOUT=900
VIDIGEN_RENDER_ALLOWED_HOSTS=
# Payment integration TEST lab. Keep enabled only for development/testing.
VIDIGEN_PAYMENT_TEST_MODE=true
GOOGLE_PAY_TEST_MODE=true
# Google Pay TEST uses its own Google Pay API configuration. This is NOT a production Paystack binding.
VITE_GOOGLE_PAY_TEST_GATEWAY=example
VITE_GOOGLE_PAY_TEST_GATEWAY_MERCHANT_ID=exampleGatewayMerchantId
VITE_GOOGLE_PAY_TEST_MERCHANT_NAME=Vidigen AI TEST
